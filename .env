# docker/.env lo crea setup_host.sh con CUDA_ARCHITECTURES detectado.
# Agrega aquí lo que quieras cambiar. Las variables que no definas
# usan el valor por defecto del compose.

# --- Build de la imagen base ---
# Arquitectura de tu GPU (nvidia-smi --query-gpu=compute_cap --format=csv)
#   75 = RTX 20xx, 86 = RTX 30xx, 89 = RTX 40xx, 120 = RTX 50xx
# CUDA_ARCHITECTURES="86"
# Compilaciones en paralelo (cada una usa 1-2 GB de RAM)
# BUILD_JOBS=4

# --- Rutas del host (absolutas, o relativas a docker/) ---
# WORKSPACE_DIR=../workspace
# VOISIS_DIR=/home/tu_usuario/proyectos/voisis
# SMART_TURN_DIR=/home/tu_usuario/proyectos/smart-turn
# MODELS_HOST_DIR=../models
# LLAMA_CPP_DIR=../llama.cpp

# --- Runtime ---
# ROS_DOMAIN_ID=0
